---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="reseller" class="sec sec--tall band--spot scal" aria-labelledby="res-h">
  <div class="container reseller">
    <div>
      <h2 id="res-h">Mau cuan bareng Krukk?</h2>
      <p class="lead">Dapat harga grosir, marketing kit gratis, dan support tim Krukk.</p>
      <div class="actions">
        <a class="btn btn--inverse" href="#">Daftar reseller</a>
      </div>
    </div>
    <div class="reseller__stage">
      <div class="reseller__photo frame" data-slot="reseller" data-alt="Reseller Krukk sedang mengemas pesanan keripik ke dalam kardus">
        <img src={`${base}/images/reseller.jpg`} width="1400" height="935" alt="Dua perempuan mengemas pesanan ke dalam kardus" loading="lazy" style="object-position: 50% 40%" />
      </div>
      <p class="poster num"><span>Modal mulai Rp</span><strong>500k</strong></p>
      <p class="caption">Sudah ada 200+ reseller di Indonesia.</p>
    </div>
  </div>
</section>
