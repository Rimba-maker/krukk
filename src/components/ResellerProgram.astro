<section id="reseller" class="color-block bg-block-lilac text-center relative overflow-hidden">
  <div class="max-w-3xl mx-auto flex flex-col items-center relative z-10">
    <span class="bg-[var(--color-accent-magenta)] text-[var(--color-on-primary)] text-caption px-[12px] py-[6px] rounded-[var(--radius-pill)] mb-[var(--spacing-md)] inline-block">
      PELUANG USAHA
    </span>
    <h2 class="text-display-lg text-balance mb-[var(--spacing-sm)]">Mau Cuan Bareng Krukk?</h2>
    <p class="text-subhead text-[var(--color-ink)]/80 mb-[var(--spacing-xl)]">
      Jadi reseller cuma butuh modal mulai Rp 500k. Dapat harga grosir, marketing kit gratis, dan support tim Krukk. Udah ada 200+ reseller di Indonesia.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-[var(--spacing-md)] w-full sm:w-auto justify-center">
      <a href="#" class="btn-primary" style="background-color: var(--color-ink); color: var(--color-canvas)">
        Daftar Reseller Sekarang
      </a>
      <a href="#" class="btn-secondary border border-[var(--color-ink)] bg-transparent">
        Pelajari Lebih Lanjut
      </a>
    </div>
  </div>

  <!-- Decorative blur blobs -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-[var(--color-block-pink)] rounded-full mix-blend-multiply filter blur-3xl opacity-50 z-0"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-[var(--color-canvas)] rounded-full mix-blend-screen filter blur-3xl opacity-50 z-0"></div>
</section>
