---
// Fill `url` with the real Krukk store page; an empty url renders a plain row, never a dead link.
const stores = [
  { name: 'Shopee', url: '' },
  { name: 'Tokopedia', url: '' },
  { name: 'TikTok Shop', url: '' },
  { name: 'Lazada', url: '' },
  { name: 'Blibli', url: '' },
];
---

<section id="belanja" class="sec sec--tall band--paper scal" aria-labelledby="buy-h">
  <div class="container">
    <div class="head">
      <h2 id="buy-h">Belanja di mana aja</h2>
      <p class="lead">Tersedia juga secara offline di beberapa cabang Indomaret dan mitra reseller kami.</p>
    </div>
    <ul class="stores">
      {stores.map(({ name, url }) => (
        <li>
          {url
            ? <a class="store" href={url}><span class="store__name">{name}</span></a>
            : <div class="store"><span class="store__name">{name}</span></div>}
        </li>
      ))}
      <li>
        <div class="store">
          <span class="store__name">Offline</span>
          <p class="store__note">Indomaret (beberapa cabang) dan reseller.</p>
        </div>
      </li>
    </ul>
  </div>
</section>
