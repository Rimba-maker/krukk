---
const credits = [
  ['hero', 9191924],
  ['bahan', 7543161],
  ['bumbu', 10527520],
  ['renyah', 13060681],
  ['kemas', 7262702],
  ['dapur', 14011352],
  ['reseller', 7674983],
];
---

<footer class="foot scal">
  <div class="container foot__grid">
    <div class="foot__mark">
      <span class="brand">Krukk!</span>
      <p>“Kruk-kruk dulu, baru produktif!”</p>
      <div class="actions">
        <a class="btn" href="https://instagram.com/krukk.id">Follow @krukk.id</a>
      </div>
    </div>
    <ul class="foot__col">
      <li><h2>Jelajah</h2></li>
      <li><a href="#varian">Varian Rasa</a></li>
      <li><a href="#cerita">Cerita Kami</a></li>
      <li><a href="#reseller">Reseller</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <ul class="foot__col">
      <li><h2>Ikuti</h2></li>
      <li><a href="https://instagram.com/krukk.id">Instagram</a></li>
      <li>TikTok</li>
      <li>Shopee</li>
    </ul>
    <div class="foot__legal">
      <p>© 2026 Krukk! Snack Nusantara. Dibuat di Lampung.</p>
      <p data-credits>
        Foto dari Pexels:
        {credits.map(([n, id], i) => (<><a href={`https://www.pexels.com/photo/${id}/`} rel="noopener">{n}</a>{i < credits.length - 1 ? ', ' : '.'}</>))}
      </p>
    </div>
  </div>
</footer>
