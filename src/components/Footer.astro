---
---

<footer class="bg-[var(--color-inverse-canvas)] text-[var(--color-inverse-ink)] py-[var(--spacing-section)] px-[var(--spacing-lg)] md:px-[var(--spacing-xxl)] rounded-t-[var(--radius-lg)]">
  <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-[var(--spacing-xl)]">
    
    <div class="md:col-span-2 flex flex-col items-start gap-[var(--spacing-md)]">
      <span class="text-display-lg tracking-tight inline-block mb-[var(--spacing-xs)]">Krukk!</span>
      <p class="text-subhead text-[var(--color-inverse-ink)]/80 max-w-md">
        "Kruk-kruk dulu, baru produktif!"
      </p>
      <a href="#" class="btn-primary bg-[var(--color-canvas)] text-[var(--color-ink)] mt-[var(--spacing-sm)]">
        Follow buat promo!
      </a>
    </div>

    <div class="flex flex-col gap-[var(--spacing-md)]">
      <h4 class="text-caption text-[var(--color-inverse-ink)]/50">Navigasi</h4>
      <div class="flex flex-col gap-[var(--spacing-sm)]">
        <a href="#varian" class="text-body-sm hover:underline underline-offset-4">Varian Rasa</a>
        <a href="#cerita" class="text-body-sm hover:underline underline-offset-4">Cerita Kami</a>
        <a href="#faq" class="text-body-sm hover:underline underline-offset-4">FAQ</a>
      </div>
    </div>

    <div class="flex flex-col gap-[var(--spacing-md)]">
      <h4 class="text-caption text-[var(--color-inverse-ink)]/50">Sosial Media</h4>
      <div class="flex flex-col gap-[var(--spacing-sm)]">
        <a href="#" class="text-body-sm hover:underline underline-offset-4">Instagram (@krukk.id)</a>
        <a href="#" class="text-body-sm hover:underline underline-offset-4">TikTok</a>
        <a href="#" class="text-body-sm hover:underline underline-offset-4">Shopee</a>
      </div>
    </div>

  </div>
  
  <div class="max-w-[1280px] mx-auto mt-[var(--spacing-section)] pt-[var(--spacing-md)] border-t border-[var(--color-inverse-ink)]/20 flex flex-col md:flex-row justify-between items-center gap-[var(--spacing-sm)]">
    <p class="text-caption text-[var(--color-inverse-ink)]/50">© 2026 Krukk! Snack Nusantara.</p>
    <p class="text-caption text-[var(--color-inverse-ink)]/50">Dibuat di Lampung.</p>
  </div>
</footer>
