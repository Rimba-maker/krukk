---
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1>Kruk-kruk renyah, nagih sampai habis!</h1>
      <p class="lead">Keripik singkong dan pisang asli Lampung. 12 rasa nendang, tanpa MSG.</p>
      <div class="actions">
        <a class="btn" href="#varian">Cobain sekarang</a>
        <a class="btn btn--text" href="#reseller">Jadi reseller</a>
      </div>
    </div>
    <div class="collage">
      <div class="collage__blob" aria-hidden="true"></div>
      <div class="collage__sun" aria-hidden="true"></div>
      <div class="collage__main frame" data-slot="hero" data-alt="Sekeranjang keripik pisang renyah buatan Krukk, difoto dari dekat">
        <img src="/images/hero.jpg" width="1200" height="1500" alt="Keripik pisang renyah menumpuk di keranjang anyaman bambu" fetchpriority="high" style="object-position: 50% 45%" />
      </div>
      <div class="collage__small frame" data-slot="hero-2" data-alt="Singkong segar, bahan dasar keripik Krukk">
        <img src="/images/bahan.jpg" width="1200" height="800" alt="" loading="lazy" />
      </div>
      <div class="collage__dot" aria-hidden="true"></div>
    </div>
  </div>
</section>
