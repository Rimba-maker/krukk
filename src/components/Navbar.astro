  ['#reseller', 'Reseller'],
  ['#faq', 'FAQ'],
  ['#belanja', 'Belanja'],
];
---

<header class="nav">
  <div class="container">
    <nav class="nav__pill" aria-label="Utama">
      <a class="nav__brand" href="/">Krukk!</a>
      <ul class="nav__links">
        {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
      <a class="btn" href="#belanja">Beli sekarang</a>
    </nav>
  </div>
</header>
