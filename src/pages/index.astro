---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero';
import VarianRasa from '../components/VarianRasa';
import WhyKrukk from '../components/WhyKrukk';
import BehindTheScene from '../components/BehindTheScene.astro';
import TestimonialWall from '../components/TestimonialWall';
import ResellerProgram from '../components/ResellerProgram.astro';
import WhereToBuy from '../components/WhereToBuy.astro';
import FAQ from '../components/FAQ';
import Footer from '../components/Footer.astro';
---

<Layout title="Krukk! — Keripik Singkong & Pisang Asli Lampung">
  <Navbar />
  <main>
    <Hero client:load />
    
    <section id="varian" class="color-block bg-block-lime">
      <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
        <h2 class="text-display-lg text-balance mb-[var(--spacing-md)]">
          12 Rasa, Mana Favoritmu?
        </h2>
        <p class="text-subhead max-w-2xl text-[var(--color-ink)]/80">
          Dari yang klasik sampai yang nendang abis. Berani coba semua?
        </p>
      </div>
      <VarianRasa client:visible />
    </section>

    <section class="py-[var(--spacing-section)]">
      <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
        <h2 class="text-display-lg text-balance mb-[var(--spacing-md)]">
          Kenapa Krukk Beda?
        </h2>
      </div>
      <WhyKrukk client:visible />
    </section>

    <BehindTheScene />

    <section class="py-[var(--spacing-section)] overflow-hidden">
      <div class="max-w-4xl mx-auto flex flex-col items-center text-center px-[var(--spacing-lg)]">
        <h2 class="text-display-lg text-balance mb-[var(--spacing-md)]">
          Apa Kata Mereka?
        </h2>
      </div>
      <TestimonialWall client:visible />
    </section>

    <ResellerProgram />
    
    <WhereToBuy />

    <section id="faq" class="color-block bg-block-coral">
      <div class="max-w-4xl mx-auto flex flex-col items-center text-center px-[var(--spacing-lg)]">
        <h2 class="text-display-lg text-balance mb-[var(--spacing-md)]">
          Pertanyaan Sering Ditanyain
        </h2>
      </div>
      <FAQ client:visible />
    </section>

  </main>
  <Footer />
</Layout>
