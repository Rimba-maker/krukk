---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import VarianRasa from '../components/VarianRasa';
import WhyKrukk from '../components/WhyKrukk.astro';
import TestimonialWall from '../components/TestimonialWall.astro';
import BehindTheScene from '../components/BehindTheScene.astro';
import FAQ from '../components/FAQ.astro';
import ResellerProgram from '../components/ResellerProgram.astro';
import WhereToBuy from '../components/WhereToBuy.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Krukk! — Keripik Singkong & Pisang Asli Lampung, 12 Varian Rasa">
  <Navbar />
  <main>
    <Hero />

    <section id="varian" class="sec" aria-labelledby="varian-h">
      <div class="container">
        <VarianRasa client:visible />
      </div>
    </section>

    <WhyKrukk />
    <TestimonialWall />
    <BehindTheScene />
    <FAQ />
    <ResellerProgram />
    <WhereToBuy />
  </main>
  <Footer />
</Layout>
